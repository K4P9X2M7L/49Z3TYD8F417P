-- Script-only toggle: change Enabled in getgenv().SlotConfig before loading.
local function startSlotLoop()
    if not loopEnabled or loopThreadRunning then
        return
    end

    loopThreadRunning = true
    task.spawn(function()
        while loopEnabled do
            for slotNum = 1, 8 do
                if not loopEnabled then
                    break
                end

                if slots["slot" .. slotNum] then
                    local ok, err = pcall(processSlot, slotNum)
                    if not ok then
                        warn("Slot " .. slotNum .. " failed: " .. tostring(err))
                    end
                    task.wait()
                end
            end
            task.wait()
        end

        loopThreadRunning = false
    end)
end

-- Start only when Enabled = true in the loader configuration.
startSlotLoop()
