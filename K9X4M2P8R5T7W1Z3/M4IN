--// RESPONSIVE POSITIONING

local cameraConnection
local repositioning = false

updatePositions = function()
    if repositioning then
        return
    end

    repositioning = true

    local camera = workspace.CurrentCamera

    if not camera then
        repositioning = false
        return
    end

    local viewport = camera.ViewportSize

    local width = math.min(620, viewport.X * 0.76)
    local height = math.min(530, viewport.Y * 0.88)

    if not minimized then
        expandedSize = UDim2.fromOffset(width, height)
        Main.Size = expandedSize
    end

    local mainX = Main.AbsolutePosition.X
    local mainY = Main.AbsolutePosition.Y
    local mainHeight = Main.AbsoluteSize.Y

    local dockY = mainY + math.min(100, mainHeight - 45)

    LeftDock.Position = UDim2.fromOffset(
        math.max(4, mainX - 46),
        dockY
    )

    LeftPopup.Position = UDim2.fromOffset(
        math.max(4, mainX - 198),
        dockY
    )

    RightDock.Position = UDim2.fromOffset(
        math.min(viewport.X - 42, mainX + Main.AbsoluteSize.X + 8),
        dockY
    )

    CodesPopup.Position = UDim2.fromOffset(
        math.min(
            viewport.X - 258,
            mainX + Main.AbsoluteSize.X + 52
        ),
        dockY
    )

    SlotsPopup.Position = UDim2.fromOffset(
        math.min(
            viewport.X - 238,
            mainX + Main.AbsoluteSize.X + 52
        ),
        dockY
    )

    if viewport.X < 900 then
        local popupHeight = activeAttribute == "BONDS" and 163 or 293

        LeftPopup.Position = UDim2.fromOffset(
            math.max(4, mainX),
            math.max(4, mainY - popupHeight)
        )

        CodesPopup.Position = UDim2.fromOffset(
            math.clamp(
                mainX + Main.AbsoluteSize.X - 250,
                4,
                math.max(4, viewport.X - 254)
            ),
            math.max(4, mainY - 373)
        )

        SlotsPopup.Position = UDim2.fromOffset(
            math.clamp(
                mainX + Main.AbsoluteSize.X - 230,
                4,
                math.max(4, viewport.X - 234)
            ),
            math.max(4, mainY - 363)
        )
    end

    repositioning = false
end

local function connectCamera()
    if cameraConnection then
        cameraConnection:Disconnect()
        cameraConnection = nil
    end

    local camera = workspace.CurrentCamera

    if camera then
        cameraConnection = camera:GetPropertyChangedSignal(
            "ViewportSize"
        ):Connect(updatePositions)
    end

    updatePositions()
end

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(connectCamera)

