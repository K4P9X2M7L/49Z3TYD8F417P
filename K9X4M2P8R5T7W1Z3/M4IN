local function horizontalSlider(parent, title, minValue, maxValue, initial, callback, formatter)
    formatter = formatter or tostring

    local holder = create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Theme.Section,
        BorderSizePixel = 0,
        ZIndex = 32
    }, parent)

    round(holder, 8)
    stroke(holder, Theme.Border, 0.65)

    create("TextLabel", {
        Position = UDim2.fromOffset(12, 8),
        Size = UDim2.new(1, -90, 0, 17),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Theme.Muted,
        Font = Enum.Font.GothamSemibold,
        TextSize = 9,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 33
    }, holder)

    local valueLabel = create("TextLabel", {
        Position = UDim2.new(1, -78, 0, 5),
        Size = UDim2.fromOffset(66, 22),
        BackgroundTransparency = 1,
        Text = formatter(initial),
        TextColor3 = Theme.AccentLight,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 33
    }, holder)

    local track = create("Frame", {
        Position = UDim2.new(0, 13, 0, 43),
        Size = UDim2.new(1, -26, 0, 4),
        BackgroundColor3 = Theme.Input,
        BorderSizePixel = 0,
        ZIndex = 33
    }, holder)
    round(track, 4)

    local fill = create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 34
    }, track)
    round(fill, 4)

    local knob = create("Frame", {
        Size = UDim2.fromOffset(13, 13),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        ZIndex = 36
    }, track)
    round(knob, 20)
    stroke(knob, Theme.AccentDark, 0.25)

    local hitbox = create("TextButton", {
        Position = UDim2.new(0, -4, 0, -10),
        Size = UDim2.new(1, 8, 0, 24),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 37
    }, track)

    local dragging = false
    local function setValue(value)
        value = math.clamp(math.floor(value + 0.5), minValue, maxValue)
        local alpha = (value - minValue) / math.max(1, maxValue - minValue)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        valueLabel.Text = formatter(value)
        if callback then callback(value) end
    end

    local function updateFromInput(input)
        local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
        setValue(minValue + alpha * (maxValue - minValue))
    end

    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInput(input)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    create("TextLabel", {
        Position = UDim2.fromOffset(12, 55),
        Size = UDim2.new(1, -24, 0, 12),
        BackgroundTransparency = 1,
        Text = formatter(minValue) .. "     —     " .. formatter(maxValue),
        TextColor3 = Theme.Subtle,
        Font = Enum.Font.Gotham,
        TextSize = 8,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 33
    }, holder)

    setValue(initial)
    return holder, setValue, function() return dragging end
end

