local function getActiveCodes()
    local result = {}
    local now = os.time()

    for code, data in pairs(CodesModule) do
        if type(data) == "table" then
            local expires = data.Expires

            if expires == nil or expires == 0 or expires > now then
                table.insert(result, code)
            end
        end
    end

    table.sort(result)

    return result
end

local function mergeNames(...)
    local result, seen = {}, {}
    for _, source in ipairs({...}) do
        for _, name in ipairs(getNames(source)) do
            if not seen[name] then
                seen[name] = true
                table.insert(result, name)
            end
        end
    end
    table.sort(result)
    return result
end

