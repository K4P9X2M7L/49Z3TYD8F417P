    clearCodeRows()

    local failed = 0
    local successCount = 0
    local usedCount = 0
    local expiredCount = 0

    for index, code in ipairs(activeCodes) do
        local requestSuccess, result = pcall(function()
            return RedeemRemote:InvokeServer(code)
