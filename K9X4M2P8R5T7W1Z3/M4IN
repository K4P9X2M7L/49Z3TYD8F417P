task.spawn(function()
    while Gui.Parent do
        local stats = SlotFarmEnv.SlotFarmStats or {}
        local attempts = tonumber(stats.Attempts) or tonumber(SlotFarmConfig.Attempts) or 0
        local elapsed = 0

        if SlotFarmConfig.StartedAt and SlotFarmConfig.StartedAt > 0 then
            local endTime = SlotFarmConfig.EndedAt > 0
                and SlotFarmConfig.EndedAt
                or os.clock()
            elapsed = math.max(0, endTime - SlotFarmConfig.StartedAt)
        end

        local hours = math.floor(elapsed / 3600)
        local minutes = math.floor((elapsed % 3600) / 60)
        local seconds = math.floor(elapsed % 60)

        SlotAttemptLabel.Text = "Attempts: " .. tostring(attempts)
        SlotElapsedLabel.Text = string.format(
            "Elapsed: %02d:%02d:%02d",
            hours,
            minutes,
            seconds
        )

        if SlotFarmConfig.Enabled == false and SlotFarmButton.Text == "STOP FARM" then
            SlotFarmStatus.Text = "Attempt limit reached or farm stopped."
            SlotFarmStatus.TextColor3 = Theme.Warning
            refreshSlotFarmButton()
        end

        task.wait(0.5)
    end
end)

