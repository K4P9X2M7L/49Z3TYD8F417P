        TextColor3 = Theme.AccentLight,
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Center
    }, holder)

    local track = create("Frame", {
        Position = UDim2.new(0.5, -1, 0, 68),
        Size = UDim2.fromOffset(2, 116),
        BackgroundColor3 = Theme.Input,
        BorderSizePixel = 0
    }, holder)

    round(track, 3)

    local fill = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0
    }, track)

    round(fill, 3)

    local knob = create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 1, 0),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        ZIndex = 5
    }, track)

    round(knob, 20)
    stroke(knob, Theme.AccentDark, 0.35)

    local hitbox = create("TextButton", {
        Position = UDim2.new(0.5, -20, 0, -9),
        Size = UDim2.new(0, 40, 1, 18),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 6
    }, track)

    local draggingSlider = false

    local function setValue(value)
        value = math.clamp(
            math.floor(value + 0.5),
            minValue,
            maxValue
        )

        local alpha = (value - minValue) / (maxValue - minValue)
        local inverted = 1 - alpha

        knob.Position = UDim2.new(0.5, 0, inverted, 0)
        fill.Size = UDim2.new(1, 0, alpha, 0)

        valueLabel.Text = formatter(value)

        if callback then
            callback(value)
        end
    end

    local function updateFromInput(input)
        local trackHeight = track.AbsoluteSize.Y

        if trackHeight <= 0 then
            return
        end

        local alpha = math.clamp(
            1 - (
                (input.Position.Y - track.AbsolutePosition.Y)
                / trackHeight
            ),
            0,
            1
        )

        setValue(minValue + alpha * (maxValue - minValue))
    end

    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            draggingSlider = true
            updateFromInput(input)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if draggingSlider and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            updateFromInput(input)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)

    create("TextLabel", {
        Position = UDim2.fromOffset(5, 191),
        Size = UDim2.new(1, -10, 0, 13),
        BackgroundTransparency = 1,
        Text = formatter(minValue) .. "  —  " .. formatter(maxValue),
        TextColor3 = Theme.Subtle,
        Font = Enum.Font.Gotham,
        TextSize = 8,
        TextXAlignment = Enum.TextXAlignment.Center
    }, holder)

    setValue(initial)

    return holder
end

