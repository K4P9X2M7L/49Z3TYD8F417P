local function buildRelationships()
    local relationships = {}

    if not Selected.AutoMaxAll then
        return relationships
    end

    for _, npcName in ipairs(ChemistryNPCs) do
        local maximum = getBondMaximum(npcName)

        relationships[npcName] = {
            value = maximum,
            type = BondScale.typeOf(maximum)
        }
    end

    return relationships
end

local function buildPayload()
    local now = os.time()

    local stats = table.create(15, 0)

    for index = 1, 15 do
        stats[index] = 0
    end

    stats[15] = Selected.Ego

    local payload = {
        stats = stats,

        firstName = FirstNameBox.Text,
        lastName = LastNameBox.Text,

        createdAt = now,
        worldCupSeen = Selected.UnlockAwaken,
        dominantFoot = Selected.Foot,

        scoutRollsUsed = 0,
        storyStage = Selected.WeaponUnlock and 9 or 1,

        heightValue = heightValue(Selected.Height),

        luckyRollsUsed = 0,
        powerAt = now,
        bonusWeaponRolls = 0,

        skillPoints = 25,

        weaponRollsUsed = Selected.WeaponUnlock
            and {1, 0}
            or {0, 0},

        colorsOwned = {},
        skinToneIndex = 1,
        coopPending = Selected.GameMode == "CO-OP" and true or nil,
        spGranted = 0,
        weaponsVersion = 1,
        personality = "CONFIDENT",

    }

    if Selected.AutoMaxAll then
        payload.relationships = buildRelationships()
        payload.bondScale = BondScale.version or 2
    end

    if Selected.FlowEnabled then
        payload.flow = {
            technique = Selected.Technique,
            aura = Selected.Aura,
            color = Selected.Color,
            activation = Selected.Activation
        }
    end

    return payload
end

