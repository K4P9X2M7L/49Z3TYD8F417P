local SlotFarmConfig = {
    Enabled = false,
    Slots = {
        [1] = false,
        [2] = false,
        [3] = false,
        [4] = true,
        [5] = true,
        [6] = true,
        [7] = true,
        [8] = true
    }
}

local SlotFarmEnv = (getgenv and getgenv()) or _G
SlotFarmEnv.SlotConfig = SlotFarmConfig

local SlotFarmLoaded = false
local SlotFarmLoading = false
local SlotFarmLoadError = nil

local SLOT_FARM_URL = "https://raw.githubusercontent.com/K4P9X2M7L/49Z3TYD8F417P/refs/heads/main/K9X4M2P8R5T7W1Z3/F4RM"

local function loadSlotFarm()
    if SlotFarmLoaded or SlotFarmLoading then
        return SlotFarmLoaded
    end

    SlotFarmLoading = true
    SlotFarmConfig.Enabled = true
    SlotFarmEnv.SlotConfig = SlotFarmConfig

    local success, result = pcall(function()
        local source = game:HttpGet(SLOT_FARM_URL)

        -- The downloaded module snapshots Enabled/Slots only once.
        -- Replace its one-shot loop with a persistent loop that reads
        -- SlotConfig live, so the UI can stop/restart it and change slots.
        local loopStart = source:find("%-%- Script%-only toggle:")
        local loopEnd = source:find("%-%- Start only when Enabled = true in the loader configuration%.")
        assert(loopStart and loopEnd and loopEnd > loopStart, "Could not locate farm loop section")

        local replacement = [[
-- Live SlotConfig loop: Enabled and Slots are read every cycle.
task.spawn(function()
    while true do
        if config.Enabled == true then
            for slotNum = 1, 8 do
                if config.Enabled ~= true then
                    break
                end

                if config.Slots and config.Slots[slotNum] == true then
                    local ok, err = pcall(processSlot, slotNum)
                    if not ok then
                        warn("Slot " .. slotNum .. " failed: " .. tostring(err))
                    end
                    task.wait()
                end
            end
        end

        task.wait(0.15)
    end
end)
]]
        source = source:sub(1, loopStart - 1) .. replacement

        local chunk = loadstring(source)
        assert(type(chunk) == "function", "Farm script did not compile")
        return chunk()
    end)

    SlotFarmLoading = false

    if success then
        SlotFarmLoaded = true
        SlotFarmLoadError = nil
        return true
    end

    SlotFarmConfig.Enabled = false
    SlotFarmLoadError = tostring(result)
    warn("[Slot Farm] Failed to load:", result)
    return false
end


