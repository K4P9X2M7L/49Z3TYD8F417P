local function getChemistryNPCs()
    local candidates = {}

    local function addName(name)
        if type(name) == "string" and name ~= "" then
            candidates[name] = true
        end
    end

    local function collectCharacters(moduleData)
        if type(moduleData) ~= "table" then
            return
        end

        local characters = moduleData.characters

        if type(characters) ~= "table" then
            return
        end

        for key, value in pairs(characters) do
            if type(value) == "table" then
                addName(value.name)
                addName(value.Name)

                if type(key) == "string" then
                    addName(key)
                end
            elseif type(key) == "string" then
                addName(key)
            end
        end
    end

    collectCharacters(NpcCharacterData)
    collectCharacters(NpcOveralls)

    local matchEngine = ReplicatedStorage:FindFirstChild("MatchEngine")
    local npcFolder = matchEngine and matchEngine:FindFirstChild("NPCs")

    if npcFolder then
        for _, module in ipairs(npcFolder:GetDescendants()) do
            if module:IsA("ModuleScript") then
                local success, npcData = pcall(require, module)

                if success and type(npcData) == "table" then
                    addName(npcData.Name)
                    addName(npcData.name)
                end
            end
        end
    end

    local result = {}

    for name in pairs(candidates) do
        local success, weapon = pcall(function()
            return ChemistryData.weaponOf(name)
                or ChemistryData.weaponOf(name, true)
        end)

        if success and weapon ~= nil then
            table.insert(result, name)
        end
    end

    table.sort(result)

    return result
end

local ChemistryNPCs = getChemistryNPCs()

local function getBondMaximum(name)
    if not name or name == "" then
        return 300
    end

    local success, maximum = pcall(function()
        return BondScale.maxFor(name)
    end)

    if success and type(maximum) == "number" then
        return math.max(1, math.floor(maximum))
    end

    return 300
end

