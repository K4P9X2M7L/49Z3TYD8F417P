        end
    end

    -- Keep Character Modifier directly below Claim Codes even when the main
    -- Character Creator window is minimized; other popups reflow around it.
    if not showMain and showCodes and characterModifierOpen then
        local pairHeight = codesHeight + gap + CharacterModifierPopup.AbsoluteSize.Y
