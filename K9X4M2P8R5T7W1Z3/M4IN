local function loadSlotFarm()
    if SlotFarmLoaded or SlotFarmLoading then
        return SlotFarmLoaded
    end

    SlotFarmLoading = true
    SlotFarmConfig.Enabled = true
    SlotFarmEnv.SlotConfig = SlotFarmConfig

    local success, result = pcall(function()
        local source = game:HttpGet(SLOT_FARM_URL)

        local loopStart = source:find("%-%- Script%-only toggle:")
        local loopEnd = source:find("%-%- Start only when Enabled = true in the loader configuration%.")
        assert(loopStart and loopEnd and loopEnd > loopStart, "Could not locate farm loop section")

        local replacement = [[
task.spawn(function()
    while true do
        if config.Enabled == true then
            for slotNum = 1, 8 do
                if config.Enabled ~= true then
                    break
                end

                if config.Slots and config.Slots[slotNum] == true then
                    local ok, err = pcall(processSlot, slotNum)
                    local env = (getgenv and getgenv()) or _G
                    env.SlotFarmStats = env.SlotFarmStats or {}
                    env.SlotFarmStats.Attempts = (env.SlotFarmStats.Attempts or 0) + 1
                    config.Attempts = env.SlotFarmStats.Attempts

                    if config.AutoStop == true
                        and tonumber(config.AttemptLimit)
                        and tonumber(config.AttemptLimit) > 0
                        and config.Attempts >= tonumber(config.AttemptLimit) then
                        config.Enabled = false
                        config.EndedAt = os.clock()
                    end

                    task.wait()
                end
            end
        end

        task.wait(0.15)
    end
end)
]]
        source = source:sub(1, loopStart - 1) .. replacement

        local chunk = loadstring(source)
        assert(type(chunk) == "function", "Farm script did not compile")
        return chunk()
    end)

    SlotFarmLoading = false

    if success then
        SlotFarmLoaded = true
        SlotFarmLoadError = nil
        return true
    end

    SlotFarmConfig.Enabled = false
    SlotFarmLoadError = tostring(result)
    return false
end

