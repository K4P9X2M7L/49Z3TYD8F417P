local function heightValue(inches)
    return MIN_HEIGHT_VALUE
        + ((inches - MIN_HEIGHT) / (MAX_HEIGHT - MIN_HEIGHT))
        * (1 - MIN_HEIGHT_VALUE)
end

local function heightText(inches)
    return string.format(
        "%d'%d\"",
        math.floor(inches / 12),
        inches % 12
    )
end

local function heightInchesFromValue(value)
    local numeric = tonumber(value)
    if not numeric then
        return MIN_HEIGHT
    end
    local alpha = (numeric - MIN_HEIGHT_VALUE) / (1 - MIN_HEIGHT_VALUE)
    return math.clamp(math.floor(MIN_HEIGHT + alpha * (MAX_HEIGHT - MIN_HEIGHT) + 0.5), MIN_HEIGHT, MAX_HEIGHT)
end

