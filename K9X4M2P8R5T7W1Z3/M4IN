--// REDEEM ALL CODES

local redeeming = false

RedeemButton.MouseButton1Click:Connect(function()
    if redeeming then
        return
    end

    local activeCodes = getActiveCodes()

    if #activeCodes == 0 then
        CodeResultSummary.Text = "No active codes found."
        CodeResultSummary.TextColor3 = Theme.Red
        clearCodeRows()
        return
    end

    redeeming = true

    RedeemButton.Text = "Claiming..."
    RedeemButton.BackgroundColor3 = Theme.Input

    CodeCountLabel.Text = #activeCodes .. " active codes found"
    CodeResultSummary.Text = "Starting redemption..."
    CodeResultSummary.TextColor3 = Theme.Muted

    CodeProgressFill.Size = UDim2.new(0, 0, 1, 0)

    clearCodeRows()

    local failed = 0
    local successCount = 0
    local usedCount = 0
    local expiredCount = 0

    for index, code in ipairs(activeCodes) do
        local requestSuccess, result = pcall(function()
            return RedeemRemote:InvokeServer(code)
        end)

        local status
        local detail
        local color

        if not requestSuccess then
            status = "REQUEST ERROR"
            detail = tostring(result)
            color = Theme.Red
            failed += 1

            warn("[Character Creator] Code request failed:", code, result)
        else
            status, detail, color = normalizeCodeResponse(result)

            if status == "SUCCESS" then
                successCount += 1
            elseif status == "ALREADY USED" then
                usedCount += 1
            elseif status == "EXPIRED" then
                expiredCount += 1
            elseif status == "FAILED"
                or status == "INVALID"
                or status == "NO RESPONSE" then

                failed += 1
            end

            print(
                "[Character Creator] Code:",
                code,
                status,
                detail
            )
        end

        addCodeResult(code, status, detail, color)

        CodeProgressFill.Size = UDim2.new(
            index / #activeCodes,
            0,
            1,
            0
        )

        CodeResultSummary.Text = string.format(
            "Processing %d/%d  •  Success: %d  •  Failed: %d",
            index,
            #activeCodes,
            successCount,
            failed
        )

        task.wait(0.15)
    end

    CodeResultSummary.Text = string.format(
        "Finished  •  Success: %d  •  Used: %d  •  Expired: %d  •  Failed: %d",
        successCount,
        usedCount,
        expiredCount,
        failed
    )

    CodeResultSummary.TextColor3 = failed == 0
        and Theme.Green
        or Theme.Red

    RedeemButton.Text = "Claim All Active Codes"
    RedeemButton.BackgroundColor3 = Theme.AccentDark

    redeeming = false
end)

