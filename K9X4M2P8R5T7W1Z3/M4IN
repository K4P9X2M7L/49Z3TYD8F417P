                        viewport.Y - edge - CharacterModifierPopup.AbsoluteSize.Y * 0.5)
                )
            end
        end

        local rightPanelX = mainRight + gap + math.max(
            showMatch and matchWidth or 0,
            showSlots and slotsWidth or 0
        ) * 0.5

        rightPanelX = math.min(
            viewport.X - edge - math.max(
                showMatch and matchWidth or 0,
                showSlots and slotsWidth or 0
            ) * 0.5,
            rightPanelX
        )

        if showMatch and showSlots then
            local totalHeight = matchHeight + gap + slotsHeight
            local top = centerY - totalHeight * 0.5
            if top < edge then
                top = edge
            end
            if top + totalHeight > viewport.Y - edge then
                top = math.max(edge, viewport.Y - edge - totalHeight)
            end

            MatchConfigPopup.Position = UDim2.fromOffset(
