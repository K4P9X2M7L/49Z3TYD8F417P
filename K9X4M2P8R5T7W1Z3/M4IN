-- Auto-hide the HUD unless the mouse is near the top edge.
local HUD_SHOW_ZONE = 85
local HUD_HIDE_ZONE = 105
local HUD_TWEEN_INFO = TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local hudShown = true
local hudTween
local bottomBarShownPosition = UDim2.new(0.5, 0, 0, 10)

local function updateBottomBarPosition(instant)
    local target = hudShown
        and bottomBarShownPosition
        or UDim2.new(0.5, 0, 0, -(BottomBar.AbsoluteSize.Y + 12))

    if hudTween then
        hudTween:Cancel()
        hudTween = nil
    end

    if instant then
        BottomBar.Position = target
    else
        hudTween = TweenService:Create(BottomBar, HUD_TWEEN_INFO, { Position = target })
        hudTween:Play()
    end
end

local function setHudShown(visible, instant)
    if hudShown == visible and not instant then
        return
    end
    hudShown = visible
    updateBottomBarPosition(instant)
end

local function updateHudFromMouse()
    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local mouseY = UIS:GetMouseLocation().Y

    if not hudShown and mouseY <= HUD_SHOW_ZONE then
        setHudShown(true, false)
    elseif hudShown and mouseY > HUD_HIDE_ZONE then
        setHudShown(false, false)
    end
end

UIS.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
