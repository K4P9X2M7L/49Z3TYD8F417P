local function saveModifierChange(changeName, mutate)
    ModifierStatus.Text = "Updating " .. changeName .. "..."
    ModifierStatus.TextColor3 = Theme.Muted
    local ok, result, detail = pcall(function()
        local activeState = require(
            Player:WaitForChild("PlayerScripts")
                :WaitForChild("CharacterUi")
                :WaitForChild("ActiveSlotState")
        )
        local slotIndex, slotData = activeState.get()
        slotIndex = tonumber(slotIndex)
        assert(slotIndex ~= nil, "Active slot index unavailable")
        assert(type(slotData) == "table", "Active slot data unavailable")
        local message = mutate(slotData)
        if type(activeState.notifyExternalChange) == "function" then
            activeState.notifyExternalChange()
        end
        local response = SaveSlot:InvokeServer(slotIndex, slotData)
        return response ~= false, message
    end)
    if ok and result then
        ModifierStatus.Text = detail or (changeName .. " save request sent.")
        ModifierStatus.TextColor3 = Theme.Green
    elseif ok then
        ModifierStatus.Text = "Server did not confirm " .. changeName .. "."
        ModifierStatus.TextColor3 = Theme.Warning
    else
        ModifierStatus.Text = changeName .. " failed: " .. tostring(result)
        ModifierStatus.TextColor3 = Theme.Red
    end
end

local function applyFlowField(field, selectedKey, labelText)
    local value = Selected[selectedKey]
    if value == nil or value == "" then
        ModifierStatus.Text = "Choose a " .. labelText .. " first."
        ModifierStatus.TextColor3 = Theme.Warning
        return
    end
    saveModifierChange(labelText, function(slotData)
        slotData.flow = type(slotData.flow) == "table" and slotData.flow or {}
        slotData.flow[field] = value
        return labelText .. " set to " .. value .. "."
    end)
end

local lastLoadedModifierEgo = nil
local lastLoadedModifierHeight = nil
local lastLoadedModifierFoot = nil
local function readModifierSlot()
    local activeState = require(
        Player:WaitForChild("PlayerScripts")
            :WaitForChild("CharacterUi")
            :WaitForChild("ActiveSlotState")
    )
    local _, slotData = activeState.get()
    assert(type(slotData) == "table", "Active slot data unavailable")
    local stats = type(slotData.stats) == "table" and slotData.stats or {}
    return {
        ego = math.clamp(math.floor(tonumber(stats[15]) or 0), 0, 300),
        height = heightInchesFromValue(slotData.heightValue),
        foot = slotData.dominantFoot == "Right" and "Right" or "Left"
    }
end

local function loadModifierValues(force)
    local ok, values = pcall(readModifierSlot)
    if not ok then
        ModifierStatus.Text = "Couldn't read current slot values: " .. tostring(values)
        ModifierStatus.TextColor3 = Theme.Warning
        return
    end

    if force or values.ego ~= lastLoadedModifierEgo then
        if not isModifierEgoSliderDragging() then
            setModifierEgoSliderValue(values.ego)
            lastLoadedModifierEgo = values.ego
        end
    end
    if force or values.height ~= lastLoadedModifierHeight then
        if not isModifierHeightSliderDragging() then
            setModifierHeightSliderValue(values.height)
            lastLoadedModifierHeight = values.height
        end
    end
    if force or values.foot ~= lastLoadedModifierFoot then
        Selected.ModifierFoot = values.foot
        ModifierFootLabel.Text = richOptionText(values.foot, "ModifierFoot")
        lastLoadedModifierFoot = values.foot
    end
end

