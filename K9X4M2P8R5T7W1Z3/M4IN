-- Read rarity/limited metadata from the original FlowData records.
local function findFlowEntry(name, key)
    local sources = {}
    if key == "ModifierTechnique" then
        sources = {FlowData.techniques}
    elseif key == "ModifierAura" then
        sources = {FlowData.auras, FlowData.rollableAuras}
    elseif key == "ModifierColor" then
        sources = {FlowData.colors, FlowData.rollableColors}
    elseif key == "ModifierActivation" then
        sources = {FlowData.activations}
    end
    for _, source in ipairs(sources) do
        for _, entry in ipairs(source or {}) do
            if type(entry) == "table" and entry.name == name then
                return entry
            end
        end
    end
end

local rarityOrder = {
    limited = 0, exclusive = 1, ["world class"] = 2,
    mythical = 3, mythic = 3, legendary = 4,
    epic = 5, rare = 6, uncommon = 7, common = 8, unknown = 9
}
local rarityColors = {
    limited = "#FF8B45", exclusive = "#FF6BCE",
    mythical = "#D58BFF", mythic = "#D58BFF", legendary = "#FFCE63",
    epic = "#C18CFF", rare = "#65B9FF", uncommon = "#70D6A3",
    common = "#C5C8D0", unknown = "#AEB2BE"
}

local function normalizeRarity(value)
    if type(value) ~= "string" then return nil end
    local normalized = string.lower(value):gsub("[%s_%-]+", " ")
        :gsub("^%s+", ""):gsub("%s+$", "")
    if normalized == "worldclass" then normalized = "world class" end
    return normalized
end

local function entryRarity(entry)
    if not entry then return "Unknown" end
    local limited = entry.limited == true or entry.Limited == true
        or entry.isLimited == true or entry.IsLimited == true
    if limited then return "Limited" end

    -- FlowData builds have used several names for the rarity field.
    local rarity = entry.rarity or entry.Rarity or entry.tier or entry.Tier
        or entry.rarityName or entry.RarityName or entry.rank or entry.Rank
        or entry.grade or entry.Grade or entry.rarityType or entry.RarityType

    if type(rarity) == "string" and rarity ~= "" then
        local normalized = normalizeRarity(rarity)
        if normalized == "world class" then return "World Class" end
        return rarity
    end

    -- Some catalogues expose World Class as the entry name itself.
    if type(entry.name) == "string"
        and normalizeRarity(entry.name) == "world class" then
        return "World Class"
    end
    return "Unknown"
end

local function sortByRarity(options, key)
    table.sort(options, function(a, b)
        local ra = normalizeRarity(entryRarity(findFlowEntry(a, key))) or "unknown"
        local rb = normalizeRarity(entryRarity(findFlowEntry(b, key))) or "unknown"
        local oa, ob = rarityOrder[ra] or rarityOrder.unknown, rarityOrder[rb] or rarityOrder.unknown
        if oa ~= ob then return oa < ob end
        return string.lower(a) < string.lower(b)
    end)
end

local function richOptionText(name, key)
    local safeName = tostring(name):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    if key ~= "ModifierTechnique" and key ~= "ModifierAura"
        and key ~= "ModifierColor" and key ~= "ModifierActivation" then
        return safeName
    end

    local rarity = entryRarity(findFlowEntry(name, key))
    if rarity == "World Class" then
        -- RichText has no inline UIGradient support, so color each character
        -- across a yellow -> pink -> blue sweep to create a smooth-looking gradient.
        local gradient = {
            {255, 244, 166}, -- light yellow
            {255, 190, 218}, -- light pink
            {174, 218, 255}  -- light blue
        }
        local text = "[World Class]"
        local pieces = {}
        local segments = #text - 1
        for i = 1, #text do
            local t = (i - 1) / segments
            local left, right, localT
            if t <= 0.5 then
                left, right, localT = gradient[1], gradient[2], t * 2
            else
                left, right, localT = gradient[2], gradient[3], (t - 0.5) * 2
            end
            local r = math.floor(left[1] + (right[1] - left[1]) * localT)
            local g = math.floor(left[2] + (right[2] - left[2]) * localT)
            local b = math.floor(left[3] + (right[3] - left[3]) * localT)
            local char = text:sub(i, i):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
            table.insert(pieces, string.format(
                '<font color="#%02X%02X%02X">%s</font>', r, g, b, char
            ))
        end
        return safeName .. " " .. table.concat(pieces)
    end

    local color = rarityColors[normalizeRarity(rarity) or "unknown"] or rarityColors.unknown
    return safeName .. ' <font color="' .. color .. '">[' .. rarity .. ']</font>'
end

sortByRarity(Techniques, "ModifierTechnique")
sortByRarity(Auras, "ModifierAura")
sortByRarity(Colors, "ModifierColor")
sortByRarity(Activations, "ModifierActivation")

