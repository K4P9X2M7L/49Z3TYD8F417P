local function normalizeCodeResponse(result)
    if result == nil then
        return "NO RESPONSE", "Server returned nil", Theme.Muted
    end

    if type(result) == "boolean" then
        if result then
            return "SUCCESS", "Server returned true", Theme.Green
        end

        return "FAILED", "Server returned false", Theme.Red
    end

    local raw = tostring(result)
    local normalized = string.upper(raw)

    if type(result) == "table" then
        local status = result.status
            or result.Status
            or result.message
            or result.Message
            or result.reason
            or result.Reason
            or result.result
            or result.Result

        local successValue = result.success

        if successValue == nil then
            successValue = result.Success
        end

        if successValue == true then
            return "SUCCESS", tostring(status or raw), Theme.Green
        elseif successValue == false then
            normalized = string.upper(tostring(status or raw))
            raw = tostring(status or raw)
        elseif status ~= nil then
            raw = tostring(status)
            normalized = string.upper(raw)
        end
    end

    if normalized:find("EXPIRED", 1, true) then
        return "EXPIRED", raw, Theme.Warning

    elseif normalized:find("USED", 1, true)
        or normalized:find("ALREADY REDEEMED", 1, true)
        or normalized:find("CLAIMED", 1, true) then

        return "ALREADY USED", raw, Theme.Muted

    elseif normalized:find("SUCCESS", 1, true)
        or normalized:find("REDEEMED", 1, true) then

        return "SUCCESS", raw, Theme.Green

    elseif normalized:find("INVALID", 1, true)
        or normalized:find("NOT FOUND", 1, true) then

        return "INVALID", raw, Theme.Red

    elseif normalized:find("FAILED", 1, true)
        or normalized:find("ERROR", 1, true) then

        return "FAILED", raw, Theme.Red
    end

    return "SERVER RESPONSE", raw, Theme.Muted
end

