local StaminaEnv = (getgenv and getgenv()) or _G
StaminaEnv.InfiniteStamina = true

if StaminaEnv.InfStaminaState then
    StaminaEnv.InfStaminaState.running = false
end

local InfStaminaState = {
    running = true,
    staminaTables = setmetatable({}, {__mode = "k"}),
    originalSpend = {}
}

StaminaEnv.InfStaminaState = InfStaminaState

local function findStaminas()
    if not getgc then return end

    local ok, objects = pcall(getgc, true)
    if not ok or type(objects) ~= "table" then return end

    for _, t in ipairs(objects) do
        if type(t) == "table" and not InfStaminaState.staminaTables[t] then
            local valid = pcall(function()
                return type(rawget(t, "spend")) == "function"
                    and type(rawget(t, "value")) == "number"
                    and type(rawget(t, "max")) == "number"
            end)

            if valid then
                local original = rawget(t, "spend")

                if type(original) == "function" then
                    InfStaminaState.staminaTables[t] = true
                    InfStaminaState.originalSpend[t] = original

                    t.spend = function(...)
                        if StaminaEnv.InfiniteStamina then
                            return
                        end

                        return original(...)
                    end
                end
            end
        end
    end
end

task.spawn(function()
    findStaminas()

    local nextScan = os.clock() + 3
    local nextRefill = 0

    while InfStaminaState.running do
        if StaminaEnv.InfiniteStamina then
            if os.clock() >= nextRefill then
                for t in pairs(InfStaminaState.staminaTables) do
                    pcall(function()
                        t.value = t.max
                    end)
                end

                nextRefill = os.clock() + 0.2
            end

            if os.clock() >= nextScan then
                findStaminas()
                nextScan = os.clock() + 3
            end
        end

        task.wait(0.05)
    end
end)

local MatchEngine = ReplicatedStorage:WaitForChild("MatchEngine")
local MatchSim = require(MatchEngine:WaitForChild("MatchSim"))
StaminaEnv.Unstealable = false

if type(MatchSim.resolveTackle) == "function" then
    if type(StaminaEnv.OriginalResolveTackle) ~= "function" then
        StaminaEnv.OriginalResolveTackle = MatchSim.resolveTackle
    end

    MatchSim.resolveTackle = function(self, tackler, victim, ...)
        if StaminaEnv.Unstealable
            and victim
            and victim.controlled
            and tackler
            and not tackler.controlled then

            if tackler.keeper then
                return false
            end

            if victim.ai then
                victim.ai.immuneUntil = math.max(
                    victim.ai.immuneUntil or 0,
                    self.clock + 0.5
                )
            end
        end

        return StaminaEnv.OriginalResolveTackle(self, tackler, victim, ...)
    end
end

