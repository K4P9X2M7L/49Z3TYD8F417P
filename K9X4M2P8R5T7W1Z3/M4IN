local function dropdown(parent, title, options, key, onChanged)
    label(parent, title)

    local button = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Theme.Input,
        BorderSizePixel = 0,
        Text = ""
    }, parent)

    round(button, 6)

    local valueLabel = create("TextLabel", {
        Position = UDim2.fromOffset(10, 0),
        Size = UDim2.new(1, -20, 1, 0),
        BackgroundTransparency = 1,
        Text = tostring(Selected[key]),
        TextColor3 = Theme.Text,
        Font = Enum.Font.Gotham,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, button)

    button.MouseButton1Click:Connect(function()
        closeDropdown()

        if #options == 0 then
            return
        end

        local popupHeight = math.min(#options * 29, 203)
        local pos = button.AbsolutePosition
        local size = button.AbsoluteSize
        local screen = Gui.AbsoluteSize

        local popupY = pos.Y + size.Y + 4

        if popupY + popupHeight > screen.Y - 8 then
            popupY = pos.Y - popupHeight - 4
        end

        local popupX = math.clamp(
            pos.X,
            5,
            math.max(5, screen.X - size.X - 5)
        )

        local popup = create("Frame", {
            Size = UDim2.fromOffset(size.X, popupHeight),
            Position = UDim2.fromOffset(popupX, popupY),
            BackgroundColor3 = Theme.Section,
            BorderSizePixel = 0,
            ZIndex = 100
        }, Gui)

        ActivePopup = popup

        round(popup, 7)
        stroke(popup, Theme.Border, 0.15)

        local list = create("ScrollingFrame", {
            Size = UDim2.new(1, -8, 1, -8),
            Position = UDim2.fromOffset(4, 4),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            CanvasSize = UDim2.fromOffset(0, #options * 29),
            ZIndex = 101
        }, popup)

        create("UIListLayout", {
            Padding = UDim.new(0, 2),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, list)

        for _, option in ipairs(options) do
            local optionButton = create("TextButton", {
                Size = UDim2.new(1, -3, 0, 27),
                BackgroundColor3 = option == Selected[key]
                    and Theme.AccentDark
                    or Theme.Section,
                BorderSizePixel = 0,
                Text = option,
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 102
            }, list)

            create("UIPadding", {
                PaddingLeft = UDim.new(0, 9)
            }, optionButton)

            optionButton.MouseButton1Click:Connect(function()
                Selected[key] = option
                valueLabel.Text = option

                closeDropdown()

                if key == "Technique" and updateTechniqueInfo then
                    updateTechniqueInfo()
                end

                if onChanged then
                    onChanged(option)
                end
            end)
        end
    end)

    return valueLabel
end

